<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/hintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hint_text"
            android:textSize="15sp"
            android:layout_marginBottom="20dp" />

        <com.wmo.foldwallpaper.TransitionPreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginBottom="4dp" />

        <SeekBar
            android:id="@+id/previewSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/previewLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="預覽:拖曳滑桿模擬開合角度(實際套用後由鉸鏈感測器自動驅動)"
            android:textSize="12sp"
            android:alpha="0.7"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageView
                    android:id="@+id/outerPreview"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:background="#22000000"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/pick_outer"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/pickOuterBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pick_outer" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageView
                    android:id="@+id/innerPreview"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:background="#22000000"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/pick_inner"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/pickInnerBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pick_inner" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/resetBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reset_images"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/setWallpaperBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/set_wallpaper"
            android:layout_marginTop="24dp" />

    </LinearLayout>
</ScrollView>
